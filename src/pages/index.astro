---
import Starfield from "../components/Starfield.astro";
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout>
    <section
        id="announcement"
        class="border border-cyan-400/80 text-cyan-400 hover:text-black hover:bg-cyan-400 p-4 cursor-pointer"
    >
        <div class="flex items-center gap-2 text-sm">
            <span class="material-symbols-sharp">campaign</span>
            <h2 class="font-bold">Website Rework Update!</h2>
        </div>

        <p class="mt-2 text-sm">
            The entire website has been reworked from the ground up. Hope you
            like it~ :]
        </p>

        <script>
            // @ts-nocheck
            const announcement =
                document.getElementById("announcement") ?? null;
            announcement.onclick = (_) => {
                announcement.classList.add("hidden");
            };
        </script>
    </section>
    <section
        class="mt-2 relative h-42 md:h-80 border border-white/50 bg-[#202020] flex items-center justify-center overflow-hidden"
    >
        <Starfield />

        <img
            src="/images/whole-gng-doodle.png"
            alt="Doodle"
            class="absolute right-0 bottom-0 h-28 md:h-60 opacity-20"
        />

        <div class="relative z-10 text-center text-white mix-blend-difference">
            <h1 class="text-4xl md:text-5xl font-bold">CoreCat</h1>
            <p class="mt-1 text-sm md:text-lg">
                Programmer, Composer, and Artist
            </p>
        </div>
    </section>

    <div class="block md:hidden w-full text-xs mt-4 text-white/50">
        <h4 class="text-center">
            (Psst, there's more! Try scrolling sideways.)
        </h4>
        <div class="w-full flex items-center">
            <span class="material-symbols-sharp">chevron_left</span>
            <div class="flex-1 border-t-2 border-dashed border-white/50"></div>
            <span class="material-symbols-sharp">chevron_right</span>
        </div>
    </div>

    <section class="mt-2 border border-white/50">
        <div class="flex flex-col md:flex-row min-h-64">
            <nav
                class="flex overflow-x-auto md:flex-col md:w-67 shrink-0 border-b md:border-b-0 md:border-r border-white/50"
            >
                <button
                    class="tab flex shrink-0 items-center gap-2 p-3 text-sm text-left bg-white/10 hover:bg-white/10"
                    data-tab="welcome"
                >
                    <span class="material-symbols-sharp">waving_hand</span>
                    Welcome
                </button>

                <button
                    class="tab flex shrink-0 items-center gap-2 p-3 text-sm text-left hover:bg-white/10"
                    data-tab="about"
                >
                    <span class="material-symbols-sharp">help</span>
                    What's this?
                </button>

                <button
                    class="tab flex shrink-0 items-center gap-2 p-3 text-sm text-left hover:bg-white/10"
                    data-tab="skills"
                >
                    <span class="material-symbols-sharp">code</span>
                    Projects
                </button>

                <button
                    class="tab flex shrink-0 items-center gap-2 p-3 text-sm text-left hover:bg-white/10"
                    data-tab="music"
                >
                    <span class="material-symbols-sharp">music_note</span>
                    Music
                </button>

                <button
                    class="tab flex shrink-0 items-center gap-2 p-3 text-sm text-left hover:bg-white/10"
                    data-tab="art"
                >
                    <span class="material-symbols-sharp">brush</span>
                    Art
                </button>
            </nav>

            <div class="flex-1 p-6">
                <div class="tab-content" data-content="welcome">
                    <h2 class="text-xl md:text-2xl font-bold">Hello! :]</h2>

                    <p
                        class="mt-3 text-sm md:text-base text-white/70 leading-relaxed"
                    >
                        I'm CoreCat. I code stuff, make music, and draw whatever
                        I feel like drawing.
                    </p>

                    <p
                        class="mt-3 text-sm md:text-base text-white/70 leading-relaxed"
                    >
                        I'm also known as "Core5570R" or simply "Core".
                    </p>
                </div>

                <div class="tab-content hidden" data-content="about">
                    <h2 class="text-xl md:text-2xl font-bold">What's this?</h2>

                    <p
                        class="mt-3 text-sm md:text-base text-white/70 leading-relaxed"
                    >
                        This is my personal website where I put my projects,
                        music, art, and other things I've made.
                    </p>

                    <p
                        class="mt-3 text-sm md:text-base text-white/70 leading-relaxed"
                    >
                        You can poke around and see what I've been working on.
                    </p>
                </div>

                <div class="tab-content hidden" data-content="skills">
                    <h2 class="text-xl md:text-2xl font-bold">Projects</h2>

                    <div class="flex gap-4 items-center opacity-70">
                        <h1 class="material-symbols-sharp text-4xl!">
                            construction
                        </h1>
                        <h1 class="4xl">Unfinished section... for now :']</h1>
                    </div>
                </div>

                <div class="tab-content hidden" data-content="music">
                    <h2 class="text-xl md:text-2xl font-bold">Music</h2>

                    <div class="flex gap-4 items-center opacity-70">
                        <h1 class="material-symbols-sharp text-4xl!">
                            construction
                        </h1>
                        <h1 class="4xl">Unfinished section... for now :']</h1>
                    </div>
                </div>

                <div class="tab-content hidden" data-content="art">
                    <h2 class="text-xl md:text-2xl font-bold">Art</h2>

                    <p
                        class="mt-3 text-sm md:text-base text-white/70 leading-relaxed"
                    >
                        I draw whatever I feel like drawing.
                    </p>

                    <img
                        src="/images/whole-gng-doodle.png"
                        alt="Doodle"
                        class="mt-4 max-w-xs"
                    />
                </div>
            </div>
        </div>
    </section>

    <script>
        // @ts-nocheck
        const tabs = document.querySelectorAll(".tab");
        const contents = document.querySelectorAll(".tab-content");

        tabs.forEach((tab) => {
            tab.addEventListener("click", () => {
                const id = tab.dataset.tab;

                tabs.forEach((tab) => tab.classList.remove("bg-white/10"));
                tab.classList.add("bg-white/10");

                contents.forEach((content) => {
                    content.classList.toggle(
                        "hidden",
                        content.dataset.content !== id,
                    );
                });
            });
        });
    </script>
</MainLayout>
