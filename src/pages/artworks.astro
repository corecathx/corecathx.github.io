---
import MainLayout from "../layouts/MainLayout.astro";
import ArtworkCard from "../components/cards/ArtworkCard.astro";

import {
    getSortedArtworks,
    getArtworkTags,
    characterTags,
    tagColors,
} from "../data/artworks";

const sortedArtworks = getSortedArtworks();
const tags = getArtworkTags();
---

<MainLayout>
    <section
        class="mt-2 relative h-42 md:h-80 border border-white/50 flex flex-col justify-center bg-[#202020] overflow-hidden"
    >
        <img
            src="/images/crowd.png"
            alt="Doodles."
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-20 w-full"
        />

        <div class="ml-6 md:ml-10 w-4/5 md:w-fit z-10">
            <h1 class="text-2xl md:text-4xl font-bold">Artworks</h1>

            <p class="mt-2 text-sm md:text-base text-white/70">
                Things I've drawn, doodled, and made.
            </p>
        </div>
    </section>

    <section class="mt-2 grid grid-cols-1 md:grid-cols-[180px_1fr] gap-2">
        <aside class="border border-white/50 p-4 h-fit md:sticky md:top-18">
            <div>
                <h2 class="text-xs text-white/40 mb-3">CHARACTER</h2>

                <div class="flex flex-wrap md:flex-col gap-2">
                    {
                        characterTags.map((tag) => {
                            const color = tagColors[tag];

                            return (
                                <button
                                    type="button"
                                    class="filter-character border border-white/50 text-white/70 hover:border-white/70 px-3 py-1 text-sm text-left"
                                    data-character={tag}
                                    data-color={color ?? ""}
                                    style={
                                        color
                                            ? `color: ${color}; border-color: ${color}80;`
                                            : undefined
                                    }
                                >
                                    {tag}
                                </button>
                            );
                        })
                    }
                </div>
            </div>

            <div class="mt-6">
                <h2 class="text-xs text-white/40 mb-3">TAGS</h2>

                <div class="flex flex-wrap md:flex-col gap-2">
                    {
                        tags.map((tag) => {
                            const color = tagColors[tag];

                            return (
                                <button
                                    type="button"
                                    class="filter-tag border border-white/50 text-white/70 hover:border-white/70 px-3 py-1 text-sm text-left"
                                    data-tag={tag}
                                    data-color={color ?? ""}
                                    style={
                                        color
                                            ? `color: ${color}; border-color: ${color}80;`
                                            : undefined
                                    }
                                >
                                    {tag}
                                </button>
                            );
                        })
                    }
                </div>
            </div>

            <button
                type="button"
                id="clear-filters"
                class="mt-6 border border-cyan-400 text-cyan-400 hover:text-black hover:bg-cyan-400 px-3 py-1 text-sm w-full"
            >
                Clear filters
            </button>
        </aside>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-2">
            {sortedArtworks.map((artwork) => <ArtworkCard artwork={artwork} />)}
        </div>
    </section>

    <dialog
        id="artwork-modal"
        class="m-auto max-w-[95vw] max-h-[95vh] bg-transparent p-0 outline-none"
    >
        <div class="relative">
            <img
                id="artwork-modal-image"
                src=""
                alt=""
                class="block max-w-[95vw] max-h-[90vh] object-contain"
            />
        </div>
    </dialog>
</MainLayout>

<style>
    #artwork-modal::backdrop {
        background: rgb(0 0 0 / 70%);
    }
</style>

<script>
    // @ts-nocheck

    const characterButtons = document.querySelectorAll(".filter-character");
    const tagButtons = document.querySelectorAll(".filter-tag");
    const artworks = document.querySelectorAll("[data-artwork]");
    const clearButton = document.querySelector("#clear-filters");

    const selectedCharacters = new Set();
    const selectedTags = new Set();

    function updateArtworks() {
        artworks.forEach((artwork) => {
            const tags = artwork.dataset.tags?.split(",") ?? [];

            const matchesCharacters =
                selectedCharacters.size === 0 ||
                [...selectedCharacters].every((tag) => tags.includes(tag));

            const matchesTags =
                selectedTags.size === 0 ||
                [...selectedTags].every((tag) => tags.includes(tag));

            artwork.classList.toggle(
                "hidden",
                !matchesCharacters || !matchesTags,
            );
        });
    }

    function updateButton(button, active) {
        const color = button.dataset.color || "#ffffff";

        if (active) {
            button.style.backgroundColor = color;
            button.style.color = "black";
            button.style.borderColor = color;
            return;
        }

        button.style.backgroundColor = "";
        button.style.color = button.dataset.color || "";
        button.style.borderColor = button.dataset.color
            ? `${button.dataset.color}80`
            : "";
    }

    characterButtons.forEach((button) => {
        button.addEventListener("click", () => {
            const tag = button.dataset.character;

            if (selectedCharacters.has(tag)) {
                selectedCharacters.delete(tag);
                updateButton(button, false);
            } else {
                selectedCharacters.add(tag);
                updateButton(button, true);
            }

            updateArtworks();
        });
    });

    tagButtons.forEach((button) => {
        button.addEventListener("click", () => {
            const tag = button.dataset.tag;

            if (selectedTags.has(tag)) {
                selectedTags.delete(tag);
                updateButton(button, false);
            } else {
                selectedTags.add(tag);
                updateButton(button, true);
            }

            updateArtworks();
        });
    });

    clearButton?.addEventListener("click", () => {
        selectedCharacters.clear();
        selectedTags.clear();

        characterButtons.forEach((button) => updateButton(button, false));
        tagButtons.forEach((button) => updateButton(button, false));

        updateArtworks();
    });

    const modal = document.querySelector("#artwork-modal");
    const image = document.querySelector("#artwork-modal-image");

    document.querySelectorAll("[data-image]").forEach((button) => {
        button.onclick = () => {
            image.src = button.dataset.image;
            image.alt = button.dataset.title;
            modal.showModal();
        };
    });

    modal.onclick = (event) => {
        if (event.target === modal) {
            modal.close();
        }
    };
</script>
