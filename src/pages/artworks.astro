---
import MainLayout from "../layouts/MainLayout.astro";
import { artworks } from "../data/artworks";

const sortedArtworks = [...artworks].sort((a, b) => {
    const [ad, am, ay] = a.date?.split("-").map(Number) ?? [0, 0, 0];
    const [bd, bm, by] = b.date?.split("-").map(Number) ?? [0, 0, 0];

    return (
        new Date(by, bm - 1, bd).getTime() - new Date(ay, am - 1, ad).getTime()
    );
});

const tags = [
    ...new Set(sortedArtworks.flatMap((artwork) => artwork.tags)),
].sort();
---

<MainLayout>
    <section
        class="mt-2 relative h-42 md:h-80 border border-white/50 flex flex-col justify-center bg-[#202020] overflow-hidden"
    >
        <img
            src="/images/crowd.png"
            alt="Doodles."
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-20 w-full"
        />

        <div class="ml-6 md:ml-10 w-4/5 md:w-fit z-10">
            <h1 class="text-2xl md:text-4xl font-bold">Artworks</h1>

            <p class="mt-2 text-sm md:text-base text-white/70">
                Things I've drawn, doodled, and made.
            </p>
        </div>
    </section>

    <section
        class="mt-2 border border-white/50 p-4 flex flex-wrap justify-center gap-3"
    >
        <!-- <div class="flex flex-wrap gap-2">
            <button
                class="filter-tag border border-cyan-400 bg-cyan-400 text-black px-3 py-1 text-sm"
                data-tag="all"
            >
                All
            </button>
        </div> -->

        <select
            id="tag-filter"
            class="border border-white/30 text-white/70 px-3 py-1 text-sm outline-none focus:border-cyan-400"
        >
            <option value="all">All tags</option>

            {tags.map((tag) => <option value={tag}>{tag}</option>)}
        </select>
    </section>

    <section class="mt-2 grid grid-cols-1 md:grid-cols-4 gap-2">
        {
            sortedArtworks.map((artwork) => (
                <article
                    data-artwork
                    data-tags={artwork.tags.join(",")}
                    class:list={[
                        "border border-white/50"
                    ]}
                >
                    <button
                        type="button"
                        class="block w-full cursor-pointer"
                        data-image={artwork.image}
                        data-title={artwork.title}
                    >
                        <img
                            src={artwork.image}
                            alt={artwork.title}
                            loading="lazy"
                            decoding="async"
                            class="block w-full bg-(--background)"
                        />
                    </button>

                    <div class="p-4">
                        <div class="flex items-baseline gap-2">
                            <h2 class="text-lg font-bold">{artwork.title}</h2>

                            {artwork.date && (
                                <time class="text-xs text-white/40">
                                    {artwork.date}
                                </time>
                            )}
                        </div>

                        {artwork.description && (
                            <p class="mt-1 text-sm text-white/60">
                                {artwork.description}
                            </p>
                        )}

                        <div class="mt-3 flex flex-wrap gap-2">
                            {artwork.tags.map((tag) => (
                                <span class="text-xs border border-white/20 px-2 py-1 text-white/60">
                                    {tag}
                                </span>
                            ))}
                        </div>
                    </div>
                </article>
            ))
        }
    </section>

    <dialog
        id="artwork-modal"
        class="m-auto max-w-[95vw] max-h-[95vh] bg-transparent p-0 outline-none"
    >
        <div class="relative">
            <img
                id="artwork-modal-image"
                src=""
                alt=""
                class="block max-w-[95vw] max-h-[90vh] object-contain"
            />
        </div>
    </dialog>
</MainLayout>

<style>
    #artwork-modal::backdrop {
        background: rgb(0 0 0 / 70%);
    }
</style>

<script>
    // @ts-nocheck

    const tagFilter = document.querySelector("#tag-filter");
    const artworks = document.querySelectorAll("[data-artwork]");

    function updateArtworks() {
        const tag = tagFilter.value;

        artworks.forEach((artwork) => {
            const tags = artwork.dataset.tags?.split(",") ?? [];

            artwork.classList.toggle(
                "hidden",
                tag !== "all" && !tags.includes(tag),
            );
        });
    }

    tagFilter?.addEventListener("change", updateArtworks);

    const modal = document.querySelector("#artwork-modal");
    const image = document.querySelector("#artwork-modal-image");

    document.querySelectorAll("[data-image]").forEach((button) => {
        button.onclick = () => {
            image.src = button.dataset.image;
            image.alt = button.dataset.title;
            modal.showModal();
        };
    });

    modal.onclick = (event) => {
        if (event.target === modal) modal.close();
    };
</script>
